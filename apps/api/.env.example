# Lokal dev qiymatlari. Production'da barcha secret'lar Secrets Manager'dan keladi.
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://matchup:matchup_dev_only@localhost:5432/matchup
REDIS_URL=redis://localhost:6379

# Ed25519 PEM kalitlar (pnpm keys:gen yaratadi). Bo'sh bo'lsa dev'da vaqtinchalik kalit generatsiya qilinadi.
JWT_PRIVATE_KEY_FILE=keys/jwt-private.pem
JWT_PUBLIC_KEY_FILE=keys/jwt-public.pem
TICKET_PRIVATE_KEY_FILE=keys/ticket-private.pem
TICKET_PUBLIC_KEY_FILE=keys/ticket-public.pem

# OTP: console (kod logga yoziladi) | eskiz
OTP_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# Payme (test kassa qiymatlari business.paycom.uz'dan)
PAYME_MERCHANT_ID=demo-payme
PAYME_KEY=payme_test_key
PAYME_CHECKOUT_URL=https://checkout.test.paycom.uz

# Click
CLICK_SERVICE_ID=1000
CLICK_MERCHANT_ID=2000
CLICK_SECRET_KEY=click_test_secret
