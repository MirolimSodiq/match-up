# Lokal dev qiymatlari. Production'da barcha secret'lar Secrets Manager'dan keladi.
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://matchup:matchup_dev_only@localhost:5432/matchup
REDIS_URL=redis://localhost:6379

# Ed25519 PEM kalitlar (pnpm keys:gen yaratadi). Bo'sh bo'lsa dev'da vaqtinchalik kalit generatsiya qilinadi.
JWT_PRIVATE_KEY_FILE=keys/jwt-private.pem
JWT_PUBLIC_KEY_FILE=keys/jwt-public.pem
TICKET_PRIVATE_KEY_FILE=keys/ticket-private.pem
TICKET_PUBLIC_KEY_FILE=keys/ticket-public.pem

# OTP: console (kod logga yoziladi) | eskiz
OTP_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# Payme (test kassa qiymatlari business.paycom.uz'dan)
PAYME_MERCHANT_ID=demo-payme
PAYME_KEY=payme_test_key
PAYME_CHECKOUT_URL=https://checkout.test.paycom.uz

# Click
CLICK_SERVICE_ID=1000
CLICK_MERCHANT_ID=2000
CLICK_SECRET_KEY=click_test_secret

# Uzum Bank Merchant API (login/parol va serviceId Uzum jamoasidan)
UZUM_SERVICE_ID=101202
UZUM_LOGIN=uzum_test_login
UZUM_PASSWORD=uzum_test_password
# params ichidagi booking id kaliti va Uzum ilovasini ochuvchi havola — ulanishda Uzum bilan tasdiqlanadi
UZUM_ACCOUNT_PARAM=booking_id
UZUM_CHECKOUT_URL=https://www.uzumbank.uz/open-service

# Kechki reconciliation (Asia/Tashkent cron). Payme: Subscribe API receipts.get_all (X-Auth: PAYME_MERCHANT_ID:PAYME_KEY)
RECONCILE_CRON="30 3 * * *"
PAYME_RECONCILE_ENABLED=false
PAYME_API_URL=https://checkout.test.paycom.uz/api

# Avtomatik provider refund'lari (to'liq summali original_method refund'lari; qisman va Uzum — admin navbati).
# Payme: Subscribe API receipts.cancel (PAYME_API_URL, reconciliation kaliti). Click: Merchant API payment/reversal
# (Auth: CLICK_MERCHANT_USER_ID + CLICK_SECRET_KEY). Sandbox'da tasdiqlanmaguncha o'chiq.
PAYME_REFUND_ENABLED=false
CLICK_REFUND_ENABLED=false
CLICK_API_URL=https://api.click.uz/v2/merchant
CLICK_MERCHANT_USER_ID=

# Host operatsiyalari. No-show ogohlantirishi Telegram ops guruhiga (TELEGRAM_BOT_TOKEN boti guruhga qo'shilgan bo'lsin);
# OPS_TELEGRAM_CHAT_ID bo'sh bo'lsa — faqat logga. Haftalik payout cron'i Asia/Tashkent bo'yicha.
OPS_TELEGRAM_CHAT_ID=
ADMIN_PUBLIC_URL=http://localhost:3100
HOST_NO_SHOW_ALERT_MIN=15
HOST_PAYOUT_CRON="0 4 * * 1"

# Social login. Client ID'lar vergul bilan; bo'sh bo'lsa provider o'chiq (422 SOCIAL_PROVIDER_DISABLED).
# Google: iOS / Android / Web OAuth client ID'lari. Apple: bundle ID (uz.matchup.player) va web uchun Services ID.
# Expo Go'da Apple token'ining aud'i — host.exp.Exponent (faqat dev'da qo'shing).
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
# Telegram Login: @BotFather token'i; bot domeni (/setdomain) = PUBLIC_BASE_URL host'i
TELEGRAM_BOT_TOKEN=
# TELEGRAM_OAUTH_URL=https://oauth.telegram.org/auth
# Telegram OAuth qaytish sahifasi faqat shu prefikslarga yo'naltiradi (dev'da Expo Go uchun exp:// ham)
TELEGRAM_APP_REDIRECTS=matchup://,exp://

# GDPR: eksport fayllari (keyin S3), yuklab olish muddati, erasure grace
STORAGE_DIR=storage
DATA_EXPORT_TTL_HOURS=168
ERASURE_GRACE_DAYS=30

# Object storage (highlight video). Lokal: MinIO (`corepack pnpm db:up` -> minio + minio-init bucket'lari).
# Production: S3_ENDPOINT bo'sh (AWS S3), kalitlar bo'sh — ECS task role; S3_FORCE_PATH_STYLE=false.
S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=   # presigned URL host'i API'nikidan farq qilsa (masalan, konteyner ichida http://minio:9000)
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=matchup
S3_SECRET_ACCESS_KEY=matchup_dev_only
S3_FORCE_PATH_STYLE=true
MEDIA_RAW_BUCKET=matchup-media-raw
MEDIA_BUCKET=matchup-media
# MEDIA_JOBS_STREAM=matchup:media-jobs
# Python worker (services/media-worker) ichki endpointlar uchun shu token bilan keladi (>= 32 belgi)
MEDIA_WORKER_TOKEN=dev-media-worker-token-0123456789abcdef
# CloudFront signed URL (prod): domen + key pair; berilmasa — S3/MinIO presigned GET
# MEDIA_CDN_DOMAIN=d111111abcdef8.cloudfront.net
# MEDIA_CDN_KEY_PAIR_ID=K2JCJMDEHXQW5F
# MEDIA_CDN_PRIVATE_KEY_FILE=keys/cloudfront-media.pem
# SHARE_LINK_TTL_DAYS=7
