{
  "expo": {
    "name": "Match Up",
    "slug": "matchup-player",
    "scheme": [
      "matchup",
      "uz.matchup.player"
    ],
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.matchup.player",
      "backgroundColor": "#F6F7FB",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "uz.matchup.player",
      "adaptiveIcon": {
        "backgroundColor": "#161B33",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#F6F7FB"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Match Up yaqin atrofdagi o'yinlarni ko'rsatish uchun joylashuvingizdan foydalanadi."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#161B33",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Match Up o'yin vaqtini kalendaringizga qo'shish uchun ruxsat so'raydi."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#F6F7FB"
  }
}
