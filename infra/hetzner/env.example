# Match Up — production sozlamalari: serverda /opt/matchup/.env (egasi deploy, 0600). docs/DEPLOYMENT.md §10.
# bootstrap.sh shu fayl asosida .env yaratadi va [generatsiya] qiymatlarini to'ldiradi.
#
# Qoidalar:
#   * Qiymatsiz qator (`KEY=`) qoldirilmaydi: ishlatilmasa — o'chiring yoki # bilan izohga oling
#     (API bo'sh qiymatni "berilgan" deb qabul qiladi va URL/son tekshiruvidan o'tmaydi). deploy.sh buni tekshiradi.
#   * O'zgartirgandan keyin: /opt/matchup/current/deploy.sh --restart (image o'zgarmaydi, servislar yangi env bilan)

# --- Domenlar va TLS --------------------------------------------------------------------------
# Domen bo'lmaguncha — sslip.io (IP'ni nomga aylantiradi, Let's Encrypt ishlaydi). Haqiqiy domenga o'tishda:
# DNS A yozuvlari -> server IP, shu ikki qatorni almashtiring, deploy.sh --restart.
API_DOMAIN=api.203-0-113-10.sslip.io
ADMIN_DOMAIN=admin.203-0-113-10.sslip.io
# Let's Encrypt hisobi uchun (majburiy)
ACME_EMAIL=ops@example.com
# Admin panelga faqat shu IP/CIDR'lardan (bo'sh joy bilan); izohda — hamma joydan
# ADMIN_ALLOW_IPS=198.51.100.7/32 2001:db8::/48

# --- [generatsiya] bootstrap.sh -----------------------------------------------------------------
DB_PASSWORD=generated-by-bootstrap
MEDIA_WORKER_TOKEN=generated-by-bootstrap-at-least-32-characters

# --- Hetzner Object Storage ---------------------------------------------------------------------
# Console -> Object Storage: bucket'lar (shu location'da) va S3 credentials.
# Endpoint — bucket location'i: hel1 (Helsinki), fsn1 (Falkenstein), nbg1 (Nuremberg)
S3_ENDPOINT=https://hel1.your-objectstorage.com
S3_REGION=hel1
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
# Xom yuklamalar (host kliplari, to'liq o'yin yozuvlari) va worker natijalari (HLS, thumbnail, MP4) — private
MEDIA_RAW_BUCKET=matchup-media-raw-change-me
MEDIA_BUCKET=matchup-media-change-me
# Kunlik pg_dump (backup.sh) — alohida private bucket
BACKUP_BUCKET=matchup-backups-change-me
# Saqlash muddatlari, kun (storage.sh deploy paytida bucket lifecycle'iga qo'yadi):
#   xom yuklamalar (asl fayllar; kliplar va HLS shu vaqtgacha tayyor bo'ladi)
# MEDIA_RAW_EXPIRATION_DAYS=3
#   to'liq o'yin videosini ko'rish muddati — API shundan keyin ko'rsatmaydi, HLS fayllari bir kun keyin o'chadi.
#   Kliplar (highlight'lar) bunga bog'liq emas — o'chirilguncha qoladi
# MEDIA_RECORDING_EXPIRATION_DAYS=7
# BACKUP_RETENTION_DAYS=14

# --- SMS (Eskiz) — majburiy: login kodlari ------------------------------------------------------
ESKIZ_EMAIL=change-me@example.com
ESKIZ_PASSWORD=change-me
# ESKIZ_FROM=4546

# --- To'lovlar ----------------------------------------------------------------------------------
# Berilmasa API test qiymatlari bilan ishlaydi (to'lov o'tmaydi) — deploy.sh ogohlantiradi.
# Payme (production URL'lari — test emas):
# PAYME_MERCHANT_ID=
# PAYME_KEY=
# PAYME_CHECKOUT_URL=https://checkout.paycom.uz
# PAYME_API_URL=https://checkout.paycom.uz/api
# PAYME_RECONCILE_ENABLED=true
# PAYME_REFUND_ENABLED=true
# Click:
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_SECRET_KEY=
# CLICK_MERCHANT_USER_ID=
# CLICK_REFUND_ENABLED=true
# Uzum:
# UZUM_SERVICE_ID=
# UZUM_LOGIN=
# UZUM_PASSWORD=
# Rahmat (Multicard) — uchala kalit berilsa to'lov usullarida ko'rinadi; production'da FISCAL_* ham majburiy:
# MULTICARD_BASE_URL=https://mesh.multicard.uz
# MULTICARD_APPLICATION_ID=
# MULTICARD_SECRET=
# MULTICARD_STORE_ID=
# MULTICARD_REFUND_ENABLED=true
# MULTICARD_PARTIAL_REFUND_ENABLED=true   # terminalda Multicard yoqqandan keyin
# Fiskal chek (barcha provider'lar): xizmat MXIK (17 raqam) va o'lchov birligi kodi — tasnif.soliq.uz.
# Eski PAYME_IKPU_CODE / PAYME_PACKAGE_CODE ham ishlaydi (FISCAL_* berilmasa).
# FISCAL_MXIK_CODE=
# FISCAL_PACKAGE_CODE=

# --- Telegram (login, host no-show ogohlantirishlari, backup xatosi) -------------------------------
# TELEGRAM_BOT_TOKEN=
# OPS_TELEGRAM_CHAT_ID=

# --- Social login va push -----------------------------------------------------------------------
# GOOGLE_CLIENT_IDS=
# APPLE_CLIENT_IDS=
# EXPO_ACCESS_TOKEN=

# --- Sentry -------------------------------------------------------------------------------------
# SENTRY_DSN_API=
# SENTRY_DSN_ADMIN=

# --- Resurslar (4 vCPU / 8 GB uchun standartlar; kattaroq serverda oshiring) -------------------------
# PG_SHARED_BUFFERS=512MB
# PG_EFFECTIVE_CACHE_SIZE=2GB
# REDIS_MAXMEMORY=384mb
# API_MEM_LIMIT=1536m
# MEDIA_WORKER_CPUS=2
# MEDIA_WORKER_MEM_LIMIT=1536m
# RECORDING_WORKER_CPUS=2
# RECORDING_WORKER_MEM_LIMIT=3g
# FFMPEG_THREADS=2
