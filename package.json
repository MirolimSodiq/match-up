{
  "name": "matchup",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:up": "docker compose up -d db redis",
    "db:down": "docker compose down",
    "db:verify": "./db/tests/verify.sh",
    "api:lint": "npx @redocly/cli@1.34.5 lint api/openapi.yaml"
  },
  "devDependencies": {
    "turbo": "^2.11.9"
  }
}
