    "@expo-google-fonts/oswald": "^0.4.2"
  },
  "peerDependencies": {
    "@expo/vector-icons": ">=15",
    "expo-blur": "*",
    "expo-linear-gradient": "*",
    "expo-status-bar": "*",
    "react": "*",
    "react-native": "*",
    "react-native-safe-area-context": "*",
    "react-native-svg": "*"
  },
  "devDependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@types/react": "~19.3.0",
    "expo": "~58.0.14",
    "expo-blur": "~58.0.4",
    "expo-font": "~58.0.8",
    "expo-linear-gradient": "~58.0.3",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "typescript": "~6.0.3"
