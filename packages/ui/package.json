{
  "name": "@matchup/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Match Up dizayn tizimi: sof TS tokenlar (@matchup/ui/tokens) va React Native komponentlar (@matchup/ui)",
  "main": "src/index.ts",
